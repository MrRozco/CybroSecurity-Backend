{
  "collectionName": "components_structure_employees",
  "info": {
    "displayName": "Team Member",
    "icon": "user",
    "description": "One person on the team: photo, name, job title, bio and social links."
  },
  "options": {},
  "attributes": {
    "profile": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "bio": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "socials": {
      "type": "component",
      "component": "structure.social-medias",
      "repeatable": true
    }
  },
  "config": {}
}
